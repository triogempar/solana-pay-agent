# Ollama Cloud. Never commit a real key.
OLLAMA_API_KEY=

# LLM provider (swappable). Defaults match Ollama Cloud + the `beam` model.
LLM_BASE_URL=https://ollama.com
LLM_MODEL=beam

# Solana devnet only. Mainnet and testnet URLs are rejected.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Agent wallet: JSON array of the 64-byte secret key, or a file path.
# Leave both empty to auto-generate data/agent-keypair.json on first run.
AGENT_SECRET_KEY=
AGENT_KEYPAIR_PATH=

# Per-transfer ceiling. Amounts above this never become a confirmation card.
MAX_SOL_PER_TRANSFER=1

# Optional overrides for local JSON storage.
CONTACTS_PATH=data/contacts.json
PENDING_TRANSFERS_PATH=data/pending-transfers.json
